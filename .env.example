NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/image_relevance

VISION_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_VISION_INPUT_COST_PER_MILLION=0.60
GROQ_VISION_OUTPUT_COST_PER_MILLION=3.00

GEMINI_API_KEY=your_gemini_api_key_here

VISION_MODEL=gemini-3.6-flash
GEMINI_VISION_INPUT_COST_PER_MILLION=
GEMINI_VISION_OUTPUT_COST_PER_MILLION=

EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_INPUT_COST_PER_MILLION=
GEMINI_EMBEDDING_OUTPUT_COST_PER_MILLION=

AI_MAX_BUDGET=5.00

EMBEDDING_MODEL_VERSION=1
GUARD_VERSION=1
